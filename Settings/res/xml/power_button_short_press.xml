<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:title="@string/power_button_press_short_title">

    <PreferenceCategory
        android:key="power_button_actions">
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_default"
            app:radioGroup="power_button_actions"
            android:title="@string/power_button_action_default" />
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_nothing"
            app:radioGroup="power_button_actions"
            android:title="@string/no_application" />
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_sleep"
            app:radioGroup="power_button_actions"
            android:title="@string/power_button_action_sleep" />
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_sleep_no_doze"
            app:radioGroup="power_button_actions"
            android:title="@string/power_button_action_sleep_no_doze" />
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_go_home"
            app:radioGroup="power_button_actions"
            android:title="@string/power_button_action_go_home" />
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_shut_off"
            app:radioGroup="power_button_actions"
            android:title="@string/power_button_action_shutdown_confirm" />
        <com.android.tv.settings.RadioPreference
            android:key="power_button_short_press_power_menu"
            app:radioGroup="power_button_actions"
            android:title="@string/power_button_action_power_menu" />
    </PreferenceCategory>

</PreferenceScreen>
