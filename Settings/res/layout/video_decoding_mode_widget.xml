<?xml version="1.0" encoding="utf-8"?>
<!--
  Inline value pill for a single codec's decoding path: an oval that shows the
  current state (AUTO / SW). Built strictly from the app's own theme resources so
  it inverts on focus and stays readable everywhere:
    - background: @drawable/password_switch_background (the app's focus pill)
    - text color: @color/tp_preference_item_primary_text_color_selector (title color)
  duplicateParentState mirrors the row's focus state. The row handles the toggle.
  -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/codec_mode_pill"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="72dp"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/password_switch_background"
    android:textColor="@color/tp_preference_item_primary_text_color_selector"
    android:duplicateParentState="true"
    android:focusable="false"
    android:clickable="false"
    android:textSize="14sp" />
